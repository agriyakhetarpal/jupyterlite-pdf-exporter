{
  "name": "jupyterlite-pdf-exporter-ui-tests",
  "version": "1.0.0",
  "description": "JupyterLab jupyterlite-pdf-exporter Integration Tests",
  "private": true,
  "scripts": {
    "start": "jupyter lab --config jupyter_server_test_config.py",
    "test": "jlpm playwright test",
    "test:update": "jlpm playwright test --update-snapshots",
    "report": "python3 scripts/build_report.py",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@hyzyla/pdfium": "2.1.13",
    "@jupyterlab/galata": "^5.0.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "~5.5.4"
  },
  "resolutions": {
    "sanitize-html": "^2.17.7",
    "vega-expression": "~5.2.1"
  }
}
